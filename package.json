{
  "name": "gesso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter gesso-playground dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter gesso-playground build && pnpm --filter gesso-devtools-extension build",
    "preview": "pnpm --filter gesso-playground preview",
    "docs:dev": "pnpm --filter gesso-docs dev",
    "docs:build": "pnpm --filter gesso-docs build",
    "docs:preview": "pnpm --filter gesso-docs preview",
    "docs:check": "node scripts/check-docs.ts",
    "docs:reference": "vite-node scripts/gen-docs-reference.ts",
    "docs:reference:check": "vite-node scripts/gen-docs-reference.ts -- --check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:docs": "tsc -p apps/docs --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm check:bundle && pnpm check:gates && pnpm api:check && pnpm docs:check && pnpm docs:reference:check && pnpm typecheck:docs && pnpm docs:build",
    "test": "vitest",
    "test:run": "vitest run",
    "fixtures:layout": "node scripts/gen-layout-fixtures.ts",
    "fixtures:text": "vite-node scripts/gen-text-fixtures.ts",
    "fixtures:text:check": "vite-node scripts/gen-text-fixtures.ts --check",
    "parity:webgpu": "node scripts/check-webgpu-parity.ts",
    "check:a11y": "node scripts/check-a11y-tree.ts",
    "check:a11y:update": "node scripts/check-a11y-tree.ts --update",
    "check:rest": "node scripts/check-rest-across-worker.ts",
    "bench:graph": "vite-node scripts/bench-graph.ts",
    "bench:frame": "vite-node scripts/bench-frame.ts",
    "bench:rewrap": "vite-node scripts/bench-rewrap.ts",
    "api:check": "node scripts/check-api.ts",
    "api:update": "node scripts/check-api.ts --update",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-template-ranges.ts",
    "changeset:publish": "pnpm --filter './packages/*' build && changeset publish",
    "check:bundle": "node scripts/check-bundle-size.ts",
    "check:gates": "node scripts/check-gates.ts",
    "check:install": "node scripts/check-install.ts",
    "check:scaffold": "node scripts/check-scaffold.ts",
    "check:scaffold:electrobun": "node scripts/check-scaffold.ts --template electrobun",
    "create:app": "node packages/create-gesso-app/bin/create-gesso-app.ts",
    "check:video": "node scripts/check-video-decode.ts",
    "screenshots": "node scripts/check-route-screenshots.ts",
    "screenshots:update": "node scripts/check-route-screenshots.ts --update",
    "docs:screenshots": "node scripts/check-docs-screenshots.ts",
    "docs:screenshots:update": "node scripts/check-docs-screenshots.ts --update"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@webgpu/types": "^0.1.71",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "rolldown": "^1.2.3",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
