{
  "name": "gesso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @gesso/playground dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter @gesso/playground build",
    "preview": "pnpm --filter @gesso/playground preview",
    "docs:dev": "pnpm --filter @gesso/docs dev",
    "docs:build": "pnpm --filter @gesso/docs build",
    "docs:preview": "pnpm --filter @gesso/docs preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "fixtures:layout": "node scripts/gen-layout-fixtures.ts",
    "parity:webgpu": "node scripts/check-webgpu-parity.ts",
    "check:a11y": "node scripts/check-a11y-tree.ts",
    "bench:graph": "vite-node scripts/bench-graph.ts",
    "api:check": "node scripts/check-api.ts",
    "api:update": "node scripts/check-api.ts --update",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check:install": "node scripts/check-install.ts",
    "check:scaffold": "node scripts/check-scaffold.ts",
    "create:app": "node packages/create-gesso-app/bin/create-gesso-app.ts",
    "screenshots": "node scripts/check-route-screenshots.ts",
    "screenshots:update": "node scripts/check-route-screenshots.ts --update"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@webgpu/types": "^0.1.71",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "rxjs": "^7.8.2",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
