# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets: an app's own environment, which is never committed. `.env.example`
# records the variable names and is.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code: local worktree checkouts and personal settings; shared config (.claude/settings.json, agents, skills) is committed
.claude/worktrees/
.claude/settings.local.json

# Screenshot gate: the capture written beside a baseline when a route fails
apps/playground/screenshots/*.actual.png
apps/docs/screenshots/*.actual.png

# Docs site: VitePress's transform cache (its build output is covered by `dist`)
apps/docs/.vitepress/cache

# Electrobun projects (apps/desk, spikes/*): Hutch's projected devkit and
# the built application bundle. Both are downloaded or generated, and the
# devkit is pinned by `hutch.config.ts` rather than by anything here.
.hutch/
build/
# Cottontail's per-build scratch, one directory per process id.
.cottontail-tmp/
# The main process, pre-bundled by `pnpm desk:bundle`. Generated from
# `src/main/index.ts` and the workspace packages, so it is output.
apps/desk/src/main/index.gen.js
