{
  /*
    Written by `hutch electrobun prepare`. It is what makes
    `electrobun/main` and `electrobun/view` resolve, so a typecheck run
    before the first prepare has nothing to resolve them against.
  */
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    /*
      The projected config sets `baseUrl`, which TypeScript 7 has removed.
      Its `paths` are relative to its own directory either way, so
      clearing it here changes nothing they resolve to.
    */
    "baseUrl": null,
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["@types/bun"],

    /* The Gesso packages ship `exports` maps, so this is the line that has to be right. */
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,

    /* The two lines that let you write elements as markup. */
    "jsx": "react-jsx",
    "jsxImportSource": "gesso-framework"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build"]
}
