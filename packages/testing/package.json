{
  "name": "gesso-testing",
  "version": "0.2.1",
  "description": "Mount a component without a browser, query it the way a screen reader would, and read back why a box is the size it is.",
  "license": "MIT",
  "author": "Kevin Baker",
  "homepage": "https://gesso-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpbaker/gesso.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/kevinpbaker/gesso/issues"
  },
  "keywords": [
    "gesso",
    "canvas",
    "ui",
    "typescript",
    "testing",
    "vitest",
    "component-testing",
    "accessibility",
    "test-utils"
  ],
  "type": "module",
  "sideEffects": [
    "./src/matchers.ts",
    "./dist/matchers.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./matchers": "./src/matchers.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./matchers": {
        "types": "./dist/matchers.d.ts",
        "default": "./dist/matchers.js"
      }
    },
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "gesso-core": "workspace:^",
    "gesso-framework": "workspace:^"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/guard-publish.ts"
  }
}
