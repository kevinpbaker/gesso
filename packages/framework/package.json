{
  "name": "gesso-framework",
  "version": "0.6.11",
  "description": "SwiftUI and Compose, for the web: declarative components, stores and a frame runtime that keeps the whole interface off the main thread.",
  "license": "MIT",
  "author": "Kevin Baker",
  "homepage": "https://gesso-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpbaker/gesso.git",
    "directory": "packages/framework"
  },
  "bugs": {
    "url": "https://github.com/kevinpbaker/gesso/issues"
  },
  "keywords": [
    "gesso",
    "canvas",
    "ui",
    "typescript",
    "framework",
    "components",
    "reactive",
    "rxjs",
    "web-worker",
    "offscreencanvas",
    "jsx",
    "state-management",
    "declarative-ui",
    "swiftui",
    "jetpack-compose",
    "native-apps"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx/jsx-dev-runtime.ts",
    "./testing": "./src/testing.ts",
    "./agent": "./src/agent/index.ts",
    "./remote": "./src/remote/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker/index.d.ts",
        "default": "./dist/worker/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx/jsx-runtime.d.ts",
        "default": "./dist/jsx/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx/jsx-dev-runtime.js"
      },
      "./agent": {
        "types": "./dist/agent/index.d.ts",
        "default": "./dist/agent/index.js"
      },
      "./remote": {
        "types": "./dist/remote/index.d.ts",
        "default": "./dist/remote/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "gesso-core": "workspace:^"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/guard-publish.ts"
  }
}
