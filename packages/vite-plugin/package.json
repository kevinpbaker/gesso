{
  "name": "gesso-vite-plugin",
  "version": "0.2.0",
  "description": "Finds a Gesso application's worker entries, writes the constructions and the hot-replacement wiring, and says when a save will reload the page.",
  "license": "MIT",
  "author": "Kevin Baker",
  "homepage": "https://gesso-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpbaker/gesso.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/kevinpbaker/gesso/issues"
  },
  "keywords": [
    "gesso",
    "canvas",
    "ui",
    "typescript",
    "vite",
    "vite-plugin",
    "hmr",
    "web-worker",
    "build-tool"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE"
  ],
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/guard-publish.ts"
  }
}
