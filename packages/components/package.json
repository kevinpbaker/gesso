{
  "name": "@gesso/components",
  "version": "0.1.0",
  "description": "The component library \u2014 five tiers, one contract.",
  "license": "MIT",
  "author": "Kevin Baker",
  "homepage": "https://github.com/kevinpbaker/gesso#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpbaker/gesso.git",
    "directory": "packages/components"
  },
  "bugs": {
    "url": "https://github.com/kevinpbaker/gesso/issues"
  },
  "keywords": [
    "gesso",
    "canvas",
    "ui",
    "typescript",
    "component-library",
    "ui-components",
    "design-system",
    "accessibility",
    "forms"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
