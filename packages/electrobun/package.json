{
  "name": "gesso-electrobun",
  "version": "0.3.0",
  "description": "Run a Gesso application in an Electrobun window, with its stores in the main process.",
  "license": "MIT",
  "author": "Kevin Baker",
  "homepage": "https://gesso-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpbaker/gesso.git",
    "directory": "packages/electrobun"
  },
  "bugs": {
    "url": "https://github.com/kevinpbaker/gesso/issues"
  },
  "keywords": [
    "gesso",
    "canvas",
    "ui",
    "typescript",
    "electrobun",
    "desktop",
    "webview",
    "native",
    "cross-platform"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./view": "./src/view.ts",
    "./main": "./src/main.ts",
    "./desktop": "./src/desktop.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./view": {
        "types": "./dist/view.d.ts",
        "default": "./dist/view.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./desktop": {
        "types": "./dist/desktop.d.ts",
        "default": "./dist/desktop.js"
      }
    },
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "gesso-framework": "workspace:^"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "rxjs": "^7.8.2"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/guard-publish.ts"
  }
}
