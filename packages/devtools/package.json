{
  "name": "@gesso/devtools",
  "version": "0.1.0",
  "description": "See what a Gesso application is doing, and what it threw: an error overlay with source-mapped stacks, drawn over the app that failed.",
  "license": "MIT",
  "author": "Kevin Baker",
  "homepage": "https://github.com/kevinpbaker/gesso#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpbaker/gesso.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/kevinpbaker/gesso/issues"
  },
  "keywords": [
    "gesso",
    "canvas",
    "ui",
    "typescript",
    "devtools",
    "debugging",
    "error-overlay",
    "profiler",
    "inspector"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@gesso/framework": "workspace:^"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/guard-publish.ts"
  }
}
